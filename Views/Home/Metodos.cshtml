<style>
#usuario
{
  margin-right: 2%; 
}
.botonesPopup 
{
  margin-left: 5%; 
}
   .metodoRecomendado{
      background-color: #DFFBFB;
      border: solid 3px #75BBEE;
      border-radius: 20px;
      padding: 1.2%;
      width: 50%;
      text-align: center;
      margin-left: 25%;
      margin-top: -6%;
    }

  #Rehacer {
    width: 1%; 
    margin-top: 15%; 
    margin-left: 78%; 
  }

    header {
      position: fixed;
      width: 100%;
      z-index: 1000;
      padding: 10px;
    }

    .carousel-container {
      width: 65%;
      margin: 5% auto;
      display: flex;
      align-items: center;
      margin-top: 2%;
    }

    .carousel-grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(20%, 5%);
      gap: 3%;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none; 
    }

    .card {
      background: #f8f8f8;
      border-radius: 15px;
      text-align: center; 
      overflow: hidden;
    }

    .card img {
      width: 100%;
      height: 76%;
      display: block;
      border-radius: 15px;
    }

    .arrow {
      background: #75BBEE ;
      border: none;
      font-size: 120%;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 50px;
      transition: 0.2s;
      z-index: 5;
    }

    .arrow:hover {
      background: rgba(255,255,255,1);
    }

    .left {
      position: absolute; 
      left: 14%;
    }

    .right {
      position: absolute; 
      right: 14%;
    }

    .metodosUsados {
      background-color: #75BBEE;
      border: solid 3px #75BBEE;
      border-radius: 20px;
      padding: 0.01%;
      width: 20%;
      text-align: center;
      margin-left: 17%;
      margin-top: 2%;
      font-size: 120%;
    }

    footer {
      margin-top: 10%;
    }

.popup-menu {
  position: fixed;
  inset: 0;
  display: none;
  justify-content: center;
  align-items: center;
  background: rgba(7, 22, 35, 0.45);
  backdrop-filter: blur(8px) saturate(1.05);
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease-in-out;
}

.popup-menu.activo {
  display: flex;
  opacity: 1;
  pointer-events: auto;
}

/* Contenedor principal: tarjeta flotante tipo "card" */
.popup-contenido {
  width: 86%;
  background-color: #D5E5F7; 
  border-radius: 20px;
  padding: 18px;
  border: 1px solid rgba(125,185,238,0.12);
  display: flex;
  flex-direction: column;
}

/* animación al abrir */
.popup-menu.activo .popup-contenido {
  transform: translateY(0) scale(1);
  opacity: 1;
}

/* Botones principales: estilo moderno con iconito a la izquierda */
.popup-contenido button {
  display: flex;
  align-items: center;
  width: 85% !important;
  padding: 5% !important; 
  border-radius: 12px;
  border: none;
  color: #fff;
  font-size: 100% !important;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(18,80,140,0.12);
  transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
}


/* estilo del icono */
.popup-contenido button::before {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(255,255,255,0.12);
  font-size: 18px;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(9,60,110,0.06) inset;
}

/* hover / active */
.popup-contenido button:hover {
  transform: translateY(-3px);
  filter: brightness(1.03);
  box-shadow: 0 14px 30px rgba(20,80,140,0.12);
}
.popup-contenido button:active {
  transform: translateY(0);
  box-shadow: 0 8px 20px rgba(20,80,140,0.08);
}

/* Botón "Cerrar" con estilo secundario (aparece como último botón) */
.popup-contenido .cerrar {
  background-color: #d11a2a !important; 
  color: #fff;
  font-weight: 700;
  box-shadow: 0 10px 24px rgba(255,92,92,0.12);
  width: 10% !important; 
  margin-left: 93% !important;
  margin-top: -10% !important;
  font-size: 100% !important; ; 
  padding: 2% !important; 
}

/* foco accesible */
.popup-contenido button:focus {
  outline: 3px solid rgba(117,187,238,0.22);
  outline-offset: 3px;
}

/* separación visual sutil arriba y abajo */
.popup-contenido::before {
  content: "";
  height: 6px;
  width: 56px;
  background: linear-gradient(90deg, rgba(0,0,0,0.06), rgba(0,0,0,0.02));
  border-radius: 999px;
  display: block;
  margin: 6px auto 8px auto;
  opacity: 0.5;
}

/* POPUP PELÍCULAS */
.popup-peliculas {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 999999;
}

.popup-peliculas.activo {
  display: flex;
}

.popup-peliculas-contenido {
  background: #D5E5F7;
  width: 55%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 25px;
  border-radius: 20px;
  text-align: center;
  position: relative;
  box-shadow: 0 0 20px rgba(0,0,0,0.25);
}

.cerrar-popup {
  position: absolute;
  right: 20px;
  top: 10px;
  font-size: 32px;
  cursor: pointer;
  font-weight: bold;
  background-color: #d11a2a; 
  width: 5%; 
  border-radius: 10px; 
  color: white; 
}

</style>
 <script>
document.addEventListener('DOMContentLoaded', () => {

  /* ===========================
     CAROUSEL (el de siempre)
  ============================ */
  const carousels = document.querySelectorAll('.carousel-container');

  carousels.forEach(container => {
    const carousel = container.querySelector('.carousel-grid');
    const btnLeft = container.querySelector('.arrow.left');
    const btnRight = container.querySelector('.arrow.right');

    btnLeft.addEventListener('click', () => {
      carousel.scrollBy({ left: -250, behavior: 'smooth' });
    });

    btnRight.addEventListener('click', () => {
      carousel.scrollBy({ left: 250, behavior: 'smooth' });
    });
  });

  /* ===========================
     POPUP DEL MENÚ HAMBURGUESA
  ============================ */
  const menu = document.getElementById('menuPopup');
  const ham = document.querySelector('.hamburguesa');
  const cerrarBtns = menu ? menu.querySelectorAll('.cerrar') : [];

  function toggleMenu() {
    const activo = menu.classList.toggle('activo');
    document.body.style.overflow = activo ? 'hidden' : '';
  }

  if (ham) {
    ham.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });
  }

  menu.addEventListener('click', (e) => {
    if (e.target === menu) toggleMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('activo')) toggleMenu();
  });

  cerrarBtns.forEach(b => b.addEventListener('click', (ev) => {
    ev.preventDefault();
    toggleMenu();
  }));

  menu.classList.remove('activo');
  document.body.style.overflow = '';

  /* ===========================
     POPUP DE PELÍCULAS
  ============================ */
  const abrirPeliculas = document.querySelector(".abrirPeliculas");
  const popupPeliculas = document.getElementById("popupPeliculas");
  const cerrarPeliculas = document.getElementById("cerrarPeliculas");

  if (abrirPeliculas && popupPeliculas && cerrarPeliculas) {

    abrirPeliculas.addEventListener("click", () => {
      popupPeliculas.classList.add("activo");
      document.body.style.overflow = "hidden";
    });

    cerrarPeliculas.addEventListener("click", () => {
      popupPeliculas.classList.remove("activo");
      document.body.style.overflow = "";
    });

    popupPeliculas.addEventListener("click", (e) => {
      if (e.target === popupPeliculas) {
        popupPeliculas.classList.remove("activo");
        document.body.style.overflow = "";
      }
    });

  } else {
    console.warn("Falta algún elemento del popup de películas");
  }

});
</script>


</body>


