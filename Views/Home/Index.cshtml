<body>
    <header class = "headerLanding">
        @{
    @using (Html.BeginForm("PedirUsuario", "Home", FormMethod.Get))
  {
    <button type="submit">Registrar Usuario</button>
  }
  @using (Html.BeginForm("IniciarSesion", "Home", FormMethod.Get))
  {
    <button type="submit">Iniciar Sesion</button>
  }
   <img src = "~/img/Logo.png" id = "LogoHeader"/>
        }
 </header>
 <main> 
 <section class="main-landing">
 <div class="titulo-main-section">
 <h1>Hackea tu Focus</h1>
        <div class = "h3Landing"> <h3>Creado por y para estudiantes. Te ayudamos a vencer la procrastinación con acompañamiento personalizado, motivación constante y métodos únicos para hacer tus tareas a tu manera.</h3> </div>
         @using (Html.BeginForm("IniciarSesion", "Home", FormMethod.Get))
  {
    <button type="submit">¡Empezá ahora!</button>
  }
  </div>
  <div>
   <img src = "~/img/Landing.png" id = "LandingPage"/>
  </div>
  <section class="tarjetas">
      <div class="motivate">
      <img src = "~/img/motivate.jpg">
      <h2>Motivate</h2>
      <p>Te motivás con recompensas por tus logros y métodos personalizados que hacen cada tarea más fácil y divertida.</p>
    
    </div>

   <div class="organizate">
      <img src = "~/img/organizate.jpg" />
      <h2>Organizate</h2>
      <p>Te organizas planificando tareas con fechas y prioridades, usando métodos que facilitan y optimizan cada actividad.</p>

    </div>

    <div class="divertite">
     <img src = "~/img/divertite.jpg"/>
      <h2>Divertite</h2>
      <p>Completá tareas de forma personalizada, ganá recompensas y mirá cómo cada tarea se convierte en un juego que te motiva a seguir.</p>
    
    </div>
  </section>

</section>
 </main>
  <footer>
        <section class="logos-footer">
      <img src = "~/img/logoFooter.png" id= logo1/>
      <section class="contenido-footer">
      <div class="botones-footer">
      <button type="button" class="btn btn-primary">Noticias</button>
      <button type="button" class="btn btn-secondary">Contactanos</button>
      <button type="button" class="btn btn-success">Sobre Nosotros</button>
      <button type="button" class="btn btn-danger">Equipo</button>
      </div>
      <div class="redes_sociales">
         <img src = "~/img/redes.png"/>
      </div>
      </section>
       <img src = "~/img/logoFooter.png" id= logo2/>
             </section>

    </footer>
</body>
<style>

body
{
   font-family: 'Arial Rounded', Arial, sans-serif;
}
header {
  width: 98%;
  background-color: #D5E5F7;
  overflow: hidden;
  background-image: url('militar.jpg');
  position: sticky;
  top: 0;
  padding: 0.5% 1%;
}
header img, footer img 
{
width: 15%; 
height: auto; 
}

 header button {
  background: #2E286B;
  border: none;
  border-radius: 15px;
  color: #fff;
  font-weight: bold;
  margin: 1% 1% ;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
  font-size: 70%;
  align-items: center;       
  justify-content: center;    
  text-align: center;
  float: right; 
}

main button:hover, header button:hover {
background: #17143b;
}
.main-landing{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2%;
    align-items: start;
    justify-content: center;
    align-content: center;
    justify-items: start;
}
.titulo-main-section{
  margin-left: 20%;
}
.titulo-main-section button 
{
  padding: 3% 5%;
  font-size: 100%; 
}

#LandingPage
{
  width: 120%;
  height: auto;
  margin-top: 7%; 
}
main h1 
{
  background-color: #75BBEE; 
  width: 60%; 
  height: auto; 
  font-size: 370%;
  color: #2E286B; 
  border-radius: 15px;
  text-align: center;
  padding: 20px;
}
main h3
{
  font-size: 150%;
  width: 70%; 
}

.organizate, .divertite, .motivate 
{
    width: 25%;
    height: 100%;
    text-align: center;
    margin-top: 3%;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: #D5E5F7;
    overflow: hidden;
    font-size: 115%;
}
main button 
{
  background: #2E286B;
  border: none;
  border-radius: 10px;
  color: #fff;
  font-weight: bold;
  padding: 1% 1%;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
  font-size: 70%;
}
 .divertite img,.organizate img, .motivate img{
    width:40%;
    height: 40%;
    object-fit: cover;
    border-bottom: 1px solid #ddd;
    border-radius: 50%;
    margin-top: 3%;
}
.tarjetas {
    display: flex;
    justify-content: center;
    align-items: center; 
    gap: 5%;
    width: 140%;
    height: 70%; 
    margin: auto;
    padding: 4% 0;
    margin-left: 30%; 
}
.tarjetas p{
  font-size: 90%;
  padding: 3% 2%;
}
footer 
{
  width: 100%;
  padding: 1%;
  margin-top: 10%; 
  background-color: #D5E5F7;
  overflow: hidden;
  background-image: url('militar.jpg');
  position: sticky;
  top: 0;
  
}
 footer button {
  background: #D5E5F7;
  color: #2C2C2C; 
  border-radius: 10px;
  font-weight: bold;
  padding: 1% 1%;
  margin: 1% 1% ;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
  font-size: 70%;   
  
}
.botones-footer{
margin-left:20%;
width: 80%;
}
footer img 
{
   width: 30%; 
   height: auto; 
}
.contenido-footer{
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: flex-end;
}
.contenido-footer img{
  margin-left: 27%;
  width: 55%;
}
.logos-footer{
    display: grid;
    grid-template-columns: 25% 30% 25%;
    justify-items: center;
    align-items: center;
    justify-content: center;
    align-content: center;
}

</style>
