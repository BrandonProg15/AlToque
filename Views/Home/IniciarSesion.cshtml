<header>
  <img src="~/img/Logo.png" id="LogoHeader" />
</header>

<main class="main-subscripcion">
  <div class="subscription-form">
    <form id="formLogin" action='@Url.Action("IniciarSesionINICIAR", "Home")' method="POST" enctype="multipart/form-data">
      <h1>Iniciar Sesión</h1>

      <div class="social-buttons">
        <a href="#">
          <img src="~/img/Google__G__logo.svg.png" id="Google" />
        </a>
        <a href="#">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/facebook/facebook-original.svg">
        </a>
        <a href="#">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/twitter/twitter-original.svg">
        </a>
      </div>

      <div class="form-group">
        Correo: <br><input type="text" name="mail" required />
      </div>

      <div class="form-group">
        Contraseña: <input type="password" name="contrasenia" required />
      </div>

      <input class="submit-btn" type="submit" value="Ingresar" />
    </form>
  </div>
</main>

<footer>
  <section class="logos-footer">
    <img src="~/img/logoFooter.png" id="logo1" />
    <section class="contenido-footer">
      <div class="botones-footer">
        <button type="button" class="btn btn-primary">Noticias</button>
        <button type="button" class="btn btn-secondary">Contactanos</button>
        <button type="button" class="btn btn-success">Sobre Nosotros</button>
        <button type="button" class="btn btn-danger">Equipo</button>
      </div>
      <div class="redes_sociales">
        <img src="~/img/redes.png" />
      </div>
    </section>
    <img src="~/img/logoFooter.png" id="logo2" />
  </section>
</footer>

